{
  "name": "sprint1",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite --port 3000 --open",
    "prebuild": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "lint": "eslint \"src/**/*.ts\" || exit 0",
    "lint:strict": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "stylelint": "stylelint \"src/**/*.scss\" --allow-empty-input",
    "stylelint:fix": "stylelint \"src/**/*.scss\" --fix --allow-empty-input",
    "check": "npm run type-check && npm run lint && npm run stylelint",
    "test": "mocha",
    "test:watch": "mocha -r ts-node/register -w 'src/**/*.test.ts'",
    "test:coverage": "nyc npm test"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/register": "^7.28.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^20.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.3",
    "@types/sinon": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "chai": "^6.2.2",
    "cors": "^2.8.6",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "express": "^5.2.1",
    "handlebars": "^4.7.8",
    "http-proxy-middleware": "^3.0.5",
    "jsdom": "^24.0.0",
    "mocha": "^11.3.0",
    "nyc": "^15.1.0",
    "postcss-scss": "^4.0.9",
    "sass": "^1.97.0",
    "sinon": "^21.0.1",
    "stylelint": "^14.16.1",
    "stylelint-config-standard": "^22.0.0",
    "stylelint-config-standard-scss": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "handlebars": "^4.7.8",
    "http-proxy-middleware": "^3.0.5"
  }
}
